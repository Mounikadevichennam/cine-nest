# CineNest Backend Environment Variables Template

# Database Connection (MySQL)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/cinenest_db

# Security & Authentication
JWT_SECRET=cinenest_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Third-Party Data API (TMDB)
TMDB_API_KEY=your_tmdb_api_key_here

# CORS Config
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
